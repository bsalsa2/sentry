# Copy this file to ".env" and fill it in for local development.
# NEVER commit the real .env - it holds secrets.

# Signs login tokens. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# Leave blank to use a local SQLite file (no setup needed).
# In production, paste the Supabase connection string here.
DATABASE_URL=

# Which website may call this API. Use your Vercel URL in production.
CORS_ORIGINS=*

# Set to 1 to load demo devices and alerts on first boot.
SEED_DEMO_DATA=0

# The port the Raspberry Pi serves its camera on.
PI_CAMERA_PORT=8000
